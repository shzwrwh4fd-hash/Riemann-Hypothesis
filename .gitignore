# .gitignore for the LaTeX sources of the paper (paper.tex, sections/, part2/)

# --- LaTeX intermediate files -------------------------------------------------
*.aux
*.lof
*.log
*.lot
*.fls
*.out
*.toc
*.fmt
*.fot
*.cb
*.cb2
.*.lb

# --- Intermediate output (XeTeX/tectonic, DVI) --------------------------------
*.dvi
*.xdv
*-converted-to.*

# --- Bibliography (BibTeX, biber) ---------------------------------------------
*.bbl
*.bbl-SAVE-ERROR
*.bcf
*.bcf-SAVE-ERROR
*.blg
*-blx.aux
*-blx.bib
*.run.xml

# --- Build tools (latexmk, SyncTeX, rubber) -----------------------------------
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)
*.pdfsync
*.rubbercache
rubber.cache

# --- Package auxiliary files --------------------------------------------------
# hyperref, bookmark
*.brf
# makeidx, glossaries, nomencl, xindy
*.idx
*.ilg
*.ind
*.glo
*.gls
*.glg
*.ist
*.acn
*.acr
*.alg
*.nlo
*.nls
*.nlg
*.xdy
# lists of listings, algorithms and theorems (thmtools)
*.lol
*.loa
*.loe
# todonotes
*.tdo
# minted, pythontex, TikZ externalization
_minted*
*.pyg
*.auxlock
*.figlist
*.makefile
*.md5
*.dpth
# latexindent backups
*.bak[0-9]*

# --- Build directories (tectonic --outdir, latexmk -outdir) -------------------
/build/
/_build/
/out/

# --- Editors and operating systems --------------------------------------------
*~
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Compiled document --------------------------------------------------------
# paper.pdf is tracked on purpose: it is the deliverable. To keep compiled
# output out of version control instead, uncomment the next line.
# *.pdf

# Note: paper.bib, sections/sA-dictionary.tex and part2/00-intro.tex are
# generated during the build but are tracked, so that paper.tex compiles on
# its own.
